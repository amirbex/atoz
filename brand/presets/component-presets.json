{
  "version": "1.0.0-draft",
  "components": [
    {
      "id": "section-tag",
      "height_px": 44,
      "uses": [
        "section_name",
        "section_color",
        "icon_or_number"
      ]
    },
    {
      "id": "headline",
      "max_lines": 3,
      "font": "Vazirmatn ExtraBold",
      "keep_one_primary_message": true
    },
    {
      "id": "evidence-source",
      "fields": [
        "source_name",
        "publication_date",
        "method_or_scope"
      ],
      "required_for_numeric_claims": true
    },
    {
      "id": "brand-footer",
      "fields": [
        "domain",
        "instagram_handle"
      ],
      "cta_target_editable": true
    },
    {
      "id": "carousel-progress",
      "role": "position only",
      "max_contrast": true
    },
    {
      "id": "reel-caption-safe-zone",
      "top_ui_clear_pct": 12,
      "bottom_ui_clear_pct": 16
    }
  ]
}
