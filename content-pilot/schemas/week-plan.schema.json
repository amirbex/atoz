{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atozfnb.info/schemas/week-plan-v2.0.0-relational-telemetry.schema.json",
  "title": "AtoZ.FnB content production and manual handoff plan",
  "description": "Production model for locally generated content; scheduling and publication are manual and outside this automation contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "brand_id",
    "period",
    "timezone",
    "locale",
    "weekly_theme",
    "goals",
    "active_channels",
    "upcoming_channels",
    "content_items",
    "deliveries",
    "relationships",
    "assets",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0-relational-telemetry"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "brand_id": {
      "const": "atoz-fnb"
    },
    "period": {
      "$ref": "#/$defs/period"
    },
    "timezone": {
      "const": "Asia/Tehran"
    },
    "locale": {
      "const": "fa-IR"
    },
    "weekly_theme": {
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "upcoming_channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "target_monthly_deliveries": {
      "type": "integer",
      "minimum": 0
    },
    "content_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contentItem"
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/delivery"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "computed_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_items",
        "assets",
        "deliveries",
        "deliveries_by_channel"
      ],
      "properties": {
        "content_items": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "type": "integer",
          "minimum": 0
        },
        "deliveries": {
          "type": "integer",
          "minimum": 0
        },
        "deliveries_by_channel": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "instagram_feed_deliveries": {
          "type": "integer",
          "minimum": 0
        },
        "instagram_story_deliveries": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month_index",
        "week_index"
      ],
      "properties": {
        "month_index": {
          "type": "integer",
          "minimum": 1
        },
        "week_index": {
          "type": "integer",
          "minimum": 1
        },
        "start_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "end_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "contentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_id",
        "pillar_id",
        "series_id",
        "primary_persona_id",
        "secondary_persona_ids",
        "objective",
        "topic",
        "core_message",
        "audience_problem",
        "evidence_level",
        "source_ids",
        "claim_ids",
        "status",
        "review_labels",
        "linked_asset_ids"
      ],
      "properties": {
        "content_id": {
          "type": "string",
          "pattern": "^ATZ-C-[0-9]{6}$"
        },
        "pillar_id": {
          "type": "string"
        },
        "series_id": {
          "type": "string"
        },
        "primary_persona_id": {
          "type": "string"
        },
        "secondary_persona_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objective": {
          "type": "string"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "core_message": {
          "type": "string",
          "minLength": 1
        },
        "audience_problem": {
          "type": "string"
        },
        "evidence_level": {
          "enum": [
            "verified",
            "experience",
            "hypothesis",
            "fictional_example"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "draft",
            "in_review",
            "approved",
            "rejected"
          ]
        },
        "review_labels": {
          "type": [
            "object",
            "null"
          ]
        },
        "linked_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ATZ-A-[0-9]{6}$"
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_id",
        "content_id",
        "schedule_key",
        "channel_id",
        "format_id",
        "planned_day_index",
        "day_name_fa",
        "planned_time_local",
        "language",
        "hook",
        "caption",
        "hashtags",
        "primary_kpi_id",
        "secondary_kpi_ids",
        "creative_spec",
        "asset_ids",
        "platform_post_id",
        "status"
      ],
      "properties": {
        "delivery_id": {
          "type": "string",
          "pattern": "^ATZ-D-[0-9]{6}$"
        },
        "content_id": {
          "type": "string",
          "pattern": "^ATZ-C-[0-9]{6}$"
        },
        "schedule_key": {
          "type": "string"
        },
        "channel_id": {
          "enum": [
            "website",
            "telegram",
            "instagram",
            "youtube"
          ]
        },
        "format_id": {
          "type": "string"
        },
        "planned_day_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "day_name_fa": {
          "enum": [
            "شنبه",
            "یکشنبه",
            "دوشنبه",
            "سه‌شنبه",
            "چهارشنبه",
            "پنج‌شنبه",
            "جمعه"
          ]
        },
        "planned_time_local": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Optional owner-entered local time; generation does not schedule publication."
        },
        "publish_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "Optional calendar timestamp entered by the owner; no scheduling is performed."
        },
        "language": {
          "type": "string"
        },
        "hook": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_kpi_id": {
          "type": "string"
        },
        "secondary_kpi_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "creative_spec": {
          "type": "object"
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ATZ-A-[0-9]{6}$"
          }
        },
        "platform_post_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "produced",
            "published",
            "skipped"
          ]
        },
        "cta": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publish_at": {
                "type": "string"
              }
            },
            "required": [
              "publish_at"
            ]
          },
          "then": {
            "properties": {
              "publish_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
              }
            }
          }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_id",
        "to_id",
        "relationship_type"
      ],
      "properties": {
        "from_id": {
          "type": "string"
        },
        "to_id": {
          "type": "string"
        },
        "relationship_type": {
          "enum": [
            "supports",
            "repurposes",
            "deepens",
            "precedes",
            "cross_links"
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "content_id",
        "delivery_id",
        "asset_type",
        "path",
        "mime_type",
        "source_or_generated",
        "license_status",
        "template_id",
        "template_version",
        "status"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^ATZ-A-[0-9]{6}$"
        },
        "content_id": {
          "type": "string",
          "pattern": "^ATZ-C-[0-9]{6}$"
        },
        "delivery_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "source_or_generated": {
          "enum": [
            "generated",
            "provided",
            "licensed"
          ]
        },
        "license_status": {
          "enum": [
            "owned",
            "approved",
            "needs_review"
          ]
        },
        "template_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "template_version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "rendered",
            "needs_review",
            "approved"
          ]
        }
      }
    }
  }
}
